APP_NAME=OtoKantar
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8080

APP_LOCALE=tr
APP_FALLBACK_LOCALE=tr
APP_FAKER_LOCALE=tr_TR
APP_TIMEZONE=Europe/Istanbul
ALLOW_PUBLIC_REGISTRATION=false
ENSURE_ADMIN=false
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Admin

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=otokantar
DB_USERNAME=otokantar
DB_PASSWORD=secret

LEGACY_DB_HOST=mysql
LEGACY_DB_PORT=3306
LEGACY_DB_DATABASE=otokantar
LEGACY_DB_USERNAME=otokantar
LEGACY_DB_PASSWORD=secret
LEGACY_RUNTIME_PATH=storage/app/legacy_python
LIVE_INGEST_API_TOKEN=local-dev-token
LIVE_INGEST_QUEUE=live-ingest

SYSTEM_HEALTH_ALERTS_ENABLED=false
SYSTEM_HEALTH_ALERT_CUSTOMER="${APP_NAME}"
SYSTEM_HEALTH_ALERT_MIN_LEVEL=warning
SYSTEM_HEALTH_ALERT_COOLDOWN_MINUTES=15
SYSTEM_HEALTH_ALERT_TIMEOUT_SECONDS=5
N8N_HEALTH_WEBHOOK_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"
