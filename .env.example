APP_NAME=OtoKantar
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost

APP_LOCALE=tr
APP_FALLBACK_LOCALE=tr
APP_FAKER_LOCALE=tr_TR
APP_TIMEZONE=Europe/Istanbul
ALLOW_PUBLIC_REGISTRATION=false
ENSURE_ADMIN=false
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Admin

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=otokantar
DB_USERNAME=root
DB_PASSWORD=

LEGACY_DB_HOST=127.0.0.1
LEGACY_DB_PORT=3306
LEGACY_DB_DATABASE=otokantar
LEGACY_DB_USERNAME=root
LEGACY_DB_PASSWORD=
LEGACY_RUNTIME_PATH=storage/app/legacy_python
LIVE_INGEST_API_TOKEN=
LIVE_INGEST_QUEUE=live-ingest
LIVE_INGEST_MAX_JSON_BYTES=262144
LIVE_INGEST_MAX_IMAGE_BYTES=2097152

BACKUP_PATH=storage/app/backups
BACKUP_KEEP=14
BACKUP_MYSQLDUMP_BINARY=C:\xampp\mysql\bin\mysqldump.exe
BACKUP_MYSQL_BINARY=C:\xampp\mysql\bin\mysql.exe
BACKUP_PG_DUMP_BINARY=pg_dump
BACKUP_PG_RESTORE_BINARY=pg_restore
BACKUP_INCLUDE_LEGACY_RUNTIME=true
BACKUP_REMOTE_ENABLED=false
BACKUP_RCLONE_BINARY=rclone
BACKUP_REMOTE_DESTINATION=
BACKUP_REMOTE_SYNC_AFTER_RUN=false

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_SECURE_COOKIE=false
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
SESSION_PATH=/
SESSION_DOMAIN=null

SECURITY_HEADERS_ENABLED=true
SECURITY_HSTS_ENABLED=false

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
