APP_NAME=OtoKantar
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://example.com

APP_LOCALE=tr
APP_FALLBACK_LOCALE=tr
APP_FAKER_LOCALE=tr_TR
APP_TIMEZONE=Europe/Istanbul

ALLOW_PUBLIC_REGISTRATION=false
ENSURE_ADMIN=true
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-this-long-random-password
ADMIN_NAME=Admin

RUN_MIGRATIONS=true

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=warning

DB_CONNECTION=pgsql
DB_URL=
DATABASE_URL=
DB_SSLMODE=require

CACHE_STORE=database
SESSION_DRIVER=database
SESSION_ENCRYPT=true
QUEUE_CONNECTION=database

LEGACY_RUNTIME_PATH=/var/www/html/storage/app/legacy_python
LIVE_INGEST_API_TOKEN=change-this-long-random-token
LIVE_INGEST_QUEUE=live-ingest
LIVE_INGEST_MAX_JSON_BYTES=262144
LIVE_INGEST_MAX_IMAGE_BYTES=2097152

BACKUP_PATH=/var/www/html/storage/app/backups
BACKUP_KEEP=14
BACKUP_MYSQLDUMP_BINARY=mysqldump
BACKUP_MYSQL_BINARY=mysql
BACKUP_PG_DUMP_BINARY=pg_dump
BACKUP_PG_RESTORE_BINARY=pg_restore
BACKUP_INCLUDE_LEGACY_RUNTIME=true
BACKUP_REMOTE_ENABLED=false
BACKUP_RCLONE_BINARY=rclone
BACKUP_REMOTE_DESTINATION=
BACKUP_REMOTE_SYNC_AFTER_RUN=false

SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

SECURITY_HEADERS_ENABLED=true
SECURITY_HSTS_ENABLED=true
SECURITY_HSTS_MAX_AGE=31536000
SECURITY_HSTS_INCLUDE_SUBDOMAINS=true
SECURITY_HSTS_PRELOAD=false

MAIL_MAILER=log
MAIL_FROM_ADDRESS=no-reply@example.com
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"
