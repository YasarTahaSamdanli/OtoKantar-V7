APP_NAME=OtoKantar
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://example.com

APP_LOCALE=tr
APP_FALLBACK_LOCALE=tr
APP_FAKER_LOCALE=tr_TR
APP_TIMEZONE=Europe/Istanbul

ALLOW_PUBLIC_REGISTRATION=false
ENSURE_ADMIN=true
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-this-long-random-password
ADMIN_NAME=Admin

RUN_MIGRATIONS=true

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=warning

DB_CONNECTION=pgsql
DB_URL=
DATABASE_URL=
DB_SSLMODE=require

CACHE_STORE=database
SESSION_DRIVER=database
SESSION_ENCRYPT=true
QUEUE_CONNECTION=database

LEGACY_RUNTIME_PATH=/var/www/html/storage/app/legacy_python
LIVE_INGEST_API_TOKEN=change-this-long-random-token

MAIL_MAILER=log
MAIL_FROM_ADDRESS=no-reply@example.com
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"
